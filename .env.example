# ========================================================
# MEDISTOCK — ENVIRONMENT CONFIGURATION
# ========================================================
# DO NOT COMMIT THIS FILE TO VERSION CONTROL
# This is a template for the production .env file.
# Copy this to .env and fill in the values.

# --------------------------------------------------------
# APPLICATION ENVIRONMENT
# --------------------------------------------------------
APP_ENV=production
FRONTEND_URL=https://medistock.example.com
CORS_ALLOWED_ORIGINS=https://medistock.example.com

# --------------------------------------------------------
# DATABASE (PostgreSQL)
# --------------------------------------------------------
DATABASE_URL=jdbc:postgresql://db.example.com:5432/medistock_prod
DATABASE_USERNAME=medistock_prod_user
DATABASE_PASSWORD=production_secure_password_here

# --------------------------------------------------------
# CACHE & QUEUES (Redis)
# --------------------------------------------------------
REDIS_URL=redis://redis.example.com:6379/0
REDIS_PASSWORD=production_redis_password_here

# --------------------------------------------------------
# AUTHENTICATION (JWT)
# --------------------------------------------------------
# Must be at least 256 bits (32 characters)
JWT_SECRET=generate_a_secure_random_string_here_for_production
JWT_EXPIRATION=86400000 # 24 hours
REFRESH_TOKEN_EXPIRATION=604800000 # 7 days

# --------------------------------------------------------
# EXTERNAL INTEGRATIONS
# --------------------------------------------------------
# Email Provider (SendGrid/AWS SES)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=sg.your_api_key_here

# AI Provider (Google Vertex AI / OpenAI)
AI_PROVIDER=google
AI_API_KEY=your_secure_ai_api_key

# Webhook Secrets
WEBHOOK_SECRET=your_secure_webhook_signing_secret

# Object Storage (AWS S3)
STORAGE_BUCKET=medistock-prod-storage
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
